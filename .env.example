# Salin menjadi `.env` lalu sesuaikan.
# ============================================================================
# PENGEMBANGAN LOKAL (MySQL di Docker / XAMPP)
# ============================================================================
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/nutri_village_ai?charset=utf8mb4

# ============================================================================
# PRODUKSI (contoh TiDB Cloud / MySQL terkelola — WAJIB TLS)
# ============================================================================
# DATABASE_URL=mysql+pymysql://<user>.root:<password>@<host>:4000/nutri_village_ai?charset=utf8mb4
# DATABASE_SSL_CA=<ISI file CA (PEM) atau path .pem>
# DATABASE_SSL_VERIFY=true
# SKIP_CREATE_DATABASE=1        # DB terkelola sudah dibuat provider
# ENVIRONMENT=production        # mengaktifkan pemeriksaan keamanan (fail-fast)

# ============================================================================
# DATA AWAL / KATALOG
# ============================================================================
# Data katalog contoh (bahan, resep, harga, musim, komoditas lokal, artikel,
# keamanan pangan, notifikasi). Default: OFF — diisi manual lewat panel admin.
# Set 1 SEKALI untuk mengisi DB pengembangan, lalu kembalikan ke 0.
SEED_CONTENT=0

# Hapus SELURUH isi tabel saat boot (mengosongkan database). Hindari di
# produksi / database bersama. Jalankan sekali, lalu kembalikan ke 0.
RESET_DATA=0

# ============================================================================
# AUTENTIKASI
# ============================================================================
# WAJIB sama dengan JWT_SECRET di frontend (web-next/.env.local / env Vercel).
# Di produksi: ganti dengan nilai rahasia acak yang kuat (jangan default ini).
JWT_SECRET=nutrivillage-dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================================
# AKUN AWAL
# ============================================================================
# true di lokal (membuat akun demo). WAJIB false di produksi.
SEED_DEMO_ACCOUNTS=true
# Admin awal untuk produksi (dibuat hanya bila belum ada):
# BOOTSTRAP_ADMIN_EMAIL=admin@contoh.id
# BOOTSTRAP_ADMIN_PASSWORD=<password kuat>
# BOOTSTRAP_ADMIN_NAME=Administrator

# ============================================================================
# CORS
# ============================================================================
# Origin frontend. Di produksi: domain Vercel, mis. https://nutrivillage.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
