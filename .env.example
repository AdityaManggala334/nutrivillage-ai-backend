# Salin menjadi `.env` lalu sesuaikan bila perlu.
# Koneksi MySQL/MariaDB XAMPP (root tanpa password).
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/nutri_village_ai?charset=utf8mb4

# WAJIB sama dengan JWT_SECRET di web-next/.env.local
JWT_SECRET=nutrivillage-dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origin frontend Next.js (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
